# Copia este archivo como `.env` y rellena los valores. El `.env` real nunca
# se sube al repositorio (está en .gitignore).

# Credenciales. Solo hace falta la del proveedor que vayas a usar.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Proveedor activo: "openai" o "anthropic".
LLM_PROVIDER=openai

# Modelo a utilizar. IMPORTANTE: debe corresponder al proveedor elegido.
#   LLM_PROVIDER=openai     -> LLM_MODEL=gpt-4o-mini
#   LLM_PROVIDER=anthropic  -> LLM_MODEL=claude-haiku-4-5
LLM_MODEL=gpt-4o-mini

# Versión de las instrucciones de estimación. Se decide solo en el backend.
LLM_PROMPT_VERSION=v1

# Entorno de ejecución y nivel de logging.
APP_ENV=development
LOG_LEVEL=DEBUG

# Comportamiento de las llamadas al proveedor LLM.
# Sin timeout explícito el SDK usa 600 segundos por defecto.
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2000
